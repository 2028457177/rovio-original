# ====== docker-compose 环境变量样板 ======
# 复制为 .env 并修改：cp .env.docker.example .env
# compose 自动读取同目录 .env 文件

# ---- MySQL ----
MYSQL_USER=root
MYSQL_PASSWORD=lc123456
MYSQL_ROOT_PASSWORD=lc123456

# ---- Redis ----
REDIS_PASSWORD=

# ---- JWT ----
# 生产必须改为随机长串
JWT_SECRET_KEY=lc-course-secret-key-2025

# ---- LLM / 搜索 / 嵌入 API Key ----
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DASHSCOPE_API_KEY=your_dashscope_api_key
TAVILY_API_KEY=your_tavily_api_key
GAODE_API_KEY=your_gaode_api_key
OPENAI_EMBEDDING_API_KEY=your_openai_embedding_api_key
EMBEDDING_API_KEY=

# ---- LangSmith 追踪（可选）----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=lc-course

# ---- 前端对外端口 ----
FRONTEND_PORT=8080
